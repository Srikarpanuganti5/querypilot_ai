# Copy to .env for local settings. Never commit .env or real credentials.
QUERYPILOT_LOG_LEVEL=INFO
# JSON array of exact browser origins; empty means cross-origin access is disabled.
QUERYPILOT_CORS_ORIGINS=[]

# Day 3: restricted read-only PostgreSQL URL when implemented.
DATABASE_URL=

# Day 6: OpenAI tool calling. No API key is needed for Day 1.
OPENAI_API_KEY=
OPENAI_MODEL=
