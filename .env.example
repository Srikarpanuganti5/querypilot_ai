# Copy to .env for local settings. Never commit .env or real credentials.
QUERYPILOT_LOG_LEVEL=INFO
# JSON array of exact browser origins; empty means cross-origin access is disabled.
QUERYPILOT_CORS_ORIGINS=[]
# Trusted operator-configured corpus directory; never accepted from tool arguments.
QUERYPILOT_DOCUMENTS_PATH=data/documents

# Local development database. Set a password locally; no credentials are supplied here.
POSTGRES_USER=querypilot_owner
POSTGRES_PASSWORD=
POSTGRES_DB=querypilot
POSTGRES_PORT=5432
# Migration/seed writer URL: postgresql+psycopg://USER:ENCODED_PASSWORD@localhost:5432/querypilot
DATABASE_URL=
# Day 4 analytics: required SELECT-only URL; no fallback to DATABASE_URL.
READER_DATABASE_URL=
QUERYPILOT_DB_POOL_SIZE=5
QUERYPILOT_DB_MAX_OVERFLOW=5
QUERYPILOT_DB_POOL_TIMEOUT=5
QUERYPILOT_DB_STATEMENT_TIMEOUT_MS=5000

# Day 6: required only for explicit --live requests. Select a supported Responses model.
OPENAI_API_KEY=
OPENAI_MODEL=
QUERYPILOT_LLM_REQUEST_TIMEOUT_SECONDS=25
QUERYPILOT_LLM_MAX_RETRIES=1
QUERYPILOT_LLM_MAX_OUTPUT_TOKENS=1600
QUERYPILOT_LLM_MAX_TOOL_CALLS=6
QUERYPILOT_LLM_TOOL_TIMEOUT_SECONDS=15
QUERYPILOT_LLM_MAX_EVIDENCE_ROWS=10
QUERYPILOT_LLM_MAX_EVIDENCE_BYTES=12000
QUERYPILOT_LLM_TOTAL_EVIDENCE_BYTES=48000

# Day 7 loop limits. Legacy LLM_MAX_TOOL_CALLS above applies only to SingleRoundService.
QUERYPILOT_AGENT_MAX_ITERATIONS=5
QUERYPILOT_AGENT_MAX_TOOL_CALLS=10
QUERYPILOT_AGENT_MAX_TOOLS_PER_ITERATION=5
QUERYPILOT_AGENT_TIMEOUT_SECONDS=90
QUERYPILOT_AGENT_MAX_CONTEXT_BYTES=128000
QUERYPILOT_AGENT_MAX_MESSAGES=128
